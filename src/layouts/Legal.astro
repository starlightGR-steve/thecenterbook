---
// Layout for the markdown legal pages (privacy, terms): the site's shared head, nav and footer
// around the .legal text column styled in global.css.
import Base from './Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import ContactModal from '../components/ContactModal.astro';
const { frontmatter } = Astro.props;
const { title, description, path } = frontmatter;
---
<Base title={`${title} | The Center Book`} description={description} path={path}>
  <Nav />
  <main id="main-content" class="legal"><slot /></main>
  <Footer />
  <ContactModal />
</Base>
