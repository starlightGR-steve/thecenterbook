<body>
<slot />

<script is:inline>
const nav=document.getElementById('nav');window.addEventListener('scroll',()=>{nav.classList.toggle('scrolled',window.scrollY>20)});
const obs=new IntersectionObserver(e=>{e.forEach(el=>{if(el.isIntersecting){el.target.style.opacity='1';el.target.style.transform='translateY(0)'}});},{threshold:.06,rootMargin:'0px 0px -40px 0px'});
document.querySelectorAll('.feature-split,.testi-card,.who-card,.founding-benefit,.check-item,.included-diagram,.pain-item').forEach(el=>{el.style.opacity='0';el.style.transform='translateY(30px)';el.style.transition='opacity .8s ease,transform .8s ease';obs.observe(el);});
</script>
<script is:inline>
function openCTA(h){var m=document.getElementById('ctaModal');document.getElementById('ctaHeading').textContent=h||'Get in Touch';document.getElementById('ctaForm').style.display='';document.getElementById('ctaDone').style.display='none';document.getElementById('ctaError').style.display='none';var b=document.getElementById('ctaSubmit');b.disabled=false;b.textContent='Send';m.classList.add('open');document.body.style.overflow='hidden';}
function closeCTA(){document.getElementById('ctaModal').classList.remove('open');document.body.style.overflow='';}
document.addEventListener('click',function(e){var el=e.target.closest('[data-cta]');if(el){e.preventDefault();openCTA(el.getAttribute('data-cta'));}});
document.addEventListener('keydown',function(e){if(e.key==='Escape')closeCTA();});
function submitCTA(){
  var name=document.getElementById('f_name'),center=document.getElementById('f_center'),email=document.getElementById('f_email');
  var ok=true;[name,center,email].forEach(function(f){f.classList.remove('field-err');if(!f.value.trim()){f.classList.add('field-err');ok=false;}});
  var ev=/^[^@\s]+@[^@\s]+\.[^@\s]+$/;if(email.value.trim()&&!ev.test(email.value.trim())){email.classList.add('field-err');ok=false;}
  var err=document.getElementById('ctaError');err.style.display='none';
  if(!ok){err.textContent='Please fill in the highlighted fields.';err.style.display='';return;}
  var btn=document.getElementById('ctaSubmit');btn.disabled=true;btn.textContent='Sending...';
  var payload={topic:document.getElementById('ctaHeading').textContent,name:name.value,center:center.value,email:email.value,phone:document.getElementById('f_phone').value,message:document.getElementById('f_message').value,website:document.getElementById('f_website').value};
  fetch('/api/contact',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)})
    .then(function(r){return r.json().catch(function(){return {};}).then(function(d){return {ok:r.ok,data:d};});})
    .then(function(res){
      if(!res.ok)throw new Error(res.data.error||"We couldn't send that just now. Please try again in a moment.");
      document.getElementById('ctaForm').style.display='none';document.getElementById('ctaDone').style.display='';
    })
    .catch(function(e){
      err.textContent=e.message||"We couldn't send that just now. Please check your connection and try again.";
      err.style.display='';btn.disabled=false;btn.textContent='Send';
    });
}
</script>
</body>
</html>
