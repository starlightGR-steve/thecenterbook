---
<section class="section bg-white">
  <div class="section-inner centered">
    <span class="script script-hero" style="color:var(--primary)">Everything. Included.</span>
    <h2 class="headline">The complete platform. All built. All yours.</h2>
    <div class="curve"></div>
    <p class="subhead" style="margin-bottom:3rem">One subscription replaces your website builder, forms, CRM, email service, SMS tool, parent portal, booking tool, and ops software. One database, one system, your entire center. Here's everything you get:</p>
  </div>
  <div class="section-inner">
    <div class="stat-tiles">
      <div class="stat-tile stat-tile--teal">
        <div class="stat-tile-num">80+</div>
        <div class="stat-tile-label">Built-in Features</div>
        <div class="stat-tile-note">Not integrations. Built into one platform.</div>
      </div>
      <div class="stat-tile stat-tile--warm">
        <div class="stat-tile-num">1</div>
        <div class="stat-tile-label">Dedicated Database</div>
        <div class="stat-tile-note">Your data. Your center. Complete isolation.</div>
      </div>
      <div class="stat-tile stat-tile--blue">
        <div class="stat-tile-num">0</div>
        <div class="stat-tile-label">Other Tools Needed</div>
        <div class="stat-tile-note">No duct tape. No third-party apps.</div>
      </div>
    </div>
    <div class="card-masonry">
      {columns.map((col) => (
        <div class="info-card shadow-lg">
          <div class="info-card-head ruled">
            <div class={`info-card-icon ${col.iconTone}`} style={`box-shadow:${col.iconShadow}`}>
              <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={col.icon} />
            </div>
            <div class={`info-card-title lg ${col.titleTone}`}>{col.label}</div>
          </div>
          <div class="tick-rows">
            {col.items.map((item) => (
              <div class="tick-row">
                <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke={col.tick} stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                <span>{item}</span>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
    <div class="centered" style="margin-top:2.5rem">
      <p class="price-note price-note--spaced">Plans start at <strong>$35/month</strong>. <a href="/pricing">See pricing</a></p>
      <a href="#" class="btn btn-founding btn-full" data-cta="Get Started">Get Started</a>
    </div>
  </div>
</section>
