---
// Logo stays the branded PNG rather than v59's inline SVG: that SVG drops the
// "e" in "the", which was fixed on main in b5ecb48.
---
<a href="#main-content" class="skip-link">Skip to content</a>
<header role="banner">
  <nav class="nav" id="nav" aria-label="Primary">
    <div class="nav-inner">
      <a href="/" class="nav-logo">
        <!-- Full lockup is ~217px wide at 48px tall; below ~520px it cannot sit
             beside the Book a Demo pill, so the compact CB mark takes over.
             Only one is ever displayed, so there is no duplicate accessible name. -->
        <img class="nav-logo-full" loading="eager" decoding="async" width="7601" height="1682" src="/images/logo-horiz.webp" alt="The Center Book" id="nav-logo">
        <img class="nav-logo-mark" loading="eager" decoding="async" width="206" height="256" src="/images/logo-mark.webp" alt="The Center Book">
      </a>
      <div class="nav-links">
        <!-- Page links sit inline on desktop and collapse into the dropdown
             behind .nav-toggle at ≤900px. Book a Demo stays visible at every width. -->
        <ul class="nav-menu" id="nav-menu">
          <li><a href="/">Home</a></li>
          <li><a href="/pricing">Pricing</a></li>
        </ul>
        <a href="#" class="btn btn-founding" data-cta="Book a Demo">Book a Demo</a>
        <button type="button" class="nav-toggle" aria-expanded="false" aria-controls="nav-menu">
          <span class="sr-only">Menu</span>
          <svg class="nav-toggle-open" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
          <svg class="nav-toggle-close" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
        </button>
      </div>
    </div>
  </nav>
</header>

<script is:inline>
(function(){
  var nav=document.getElementById('nav'),btn=nav.querySelector('.nav-toggle');
  function setOpen(open){nav.classList.toggle('menu-open',open);btn.setAttribute('aria-expanded',open?'true':'false');}
  btn.addEventListener('click',function(){setOpen(!nav.classList.contains('menu-open'));});
  nav.querySelectorAll('.nav-menu a').forEach(function(a){a.addEventListener('click',function(){setOpen(false);});});
  document.addEventListener('keydown',function(e){if(e.key==='Escape'&&nav.classList.contains('menu-open')){setOpen(false);btn.focus();}});
  document.addEventListener('click',function(e){if(nav.classList.contains('menu-open')&&!nav.contains(e.target))setOpen(false);});
})();
</script>
