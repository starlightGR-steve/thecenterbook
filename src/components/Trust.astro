---
const cards = [
  {
    icon: 'database',
    title: 'Isolated database per center',
    body: "Your center's data lives in its own database, never mixed with any other center's.",
  },
  {
    icon: 'history',
    title: 'Audit trail on every change',
    body: 'Logins, record edits, timeclock, shifts, and permission changes all land in one activity log.',
  },
  {
    icon: 'undo',
    title: 'Soft delete with restore',
    body: 'Students, contacts, and staff records archive instead of vanishing, so nothing is lost by accident.',
  },
];
---
<section class="section bg-cool">
  <div class="section-inner centered">
    <span class="eyebrow" style="color:var(--secondary-text)">Built to be trusted with your data</span>
    <h2 class="headline" style="max-width:820px;margin:0 auto">Your center's data, protected and yours.</h2>
    <div class="curve"></div>
    <div class="card-grid" style="margin-top:1.6rem;text-align:left">
      {cards.map((c) => (
        <div class="info-card roomy">
          <div class="info-card-icon lg info-card-icon--teal" style="box-shadow:0 6px 16px rgba(0,171,189,.28)">
            {c.icon === 'database' && (
              <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5V19A9 3 0 0 0 21 19V5"/><path d="M3 12A9 3 0 0 0 21 12"/></svg>
            )}
            {c.icon === 'history' && (
              <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/><path d="M12 7v5l4 2"/></svg>
            )}
            {c.icon === 'undo' && (
              <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 14 4 9l5-5"/><path d="M4 9h10.5a5.5 5.5 0 0 1 0 11H10"/></svg>
            )}
          </div>
          <h3>{c.title}</h3>
          <p>{c.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>
