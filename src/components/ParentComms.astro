---
---
<section class="section bg-warm">
  <div class="dots" aria-hidden="true" style="width:100px;height:120px;bottom:30px;right:40px"></div>
  <div class="section-inner">
    <span class="eyebrow" style="color:var(--accent-text)">Parent Communication</span>
    <div class="feature-split reverse">
      <div class="feat-text">
        <span class="script script-xl" style="color:var(--accent-text)">Stay Connected Without the Chaos</span>
        <h2 class="headline">Parents stay informed. Staff stay focused.</h2>
        <p class="subhead">Automated texts, two-way messaging, consent tracking, milestone celebrations, and progress meeting workflows. Every message logged and connected to the right student.</p>
        <div class="feat-points">
          <div class="feat-point">
            <div class="feat-point-icon solid solid-orange">
              <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m22 2-7 20-4-9-9-4Z"/><path d="M22 2 11 13"/></svg>
            </div>
            <span><strong style="color:var(--text)">Automated pickup + 5-min reminders</strong><br>Parent Touchpoint and bathroom-request alerts</span>
          </div>
          <div class="feat-point">
            <div class="feat-point-icon solid solid-orange">
              <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            </div>
            <span><strong style="color:var(--text)">Two-way SMS inbox</strong><br>Per-contact threads, manual send, no personal phones</span>
          </div>
          <div class="feat-point">
            <div class="feat-point-icon solid solid-orange">
              <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
            </div>
            <span><strong style="color:var(--text)">SMS consent tracking</strong><br>Immutable consent history with automatic STOP and START handling</span>
          </div>
          <div class="feat-point">
            <div class="feat-point-icon solid solid-orange">
              <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            </div>
            <span><strong style="color:var(--text)">Level-up emails + progress meetings</strong><br>Parents self-book with Zoom and calendar sync, with a full history trail per student</span>
          </div>
        </div>
        <div><a href="#" class="btn btn-founding" data-cta="Learn More">Learn More</a></div>
      </div>
      <div class="feat-visual">
        <div class="blob" aria-hidden="true" style="background:radial-gradient(circle,rgba(224,113,44,.15),transparent 68%);width:122%;height:122%;top:-11%;left:-11%"></div>
        <div class="shot"><img loading="lazy" decoding="async" width="1150" height="873" src="/images/sms-inbox.webp" alt="Two-way SMS inbox"></div>
        <div class="phone-overlay"><img loading="lazy" decoding="async" width="450" height="900" src="/images/pickup-text.webp" alt="Automated pickup text a parent receives"></div>
        <div class="float-el" style="top:20px;left:-20px;border-left:3px solid var(--accent)">
          <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#b85a1a" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/></svg> Configurable alert routing
        </div>
      </div>
    </div>
  </div>
</section>
