<section class="section bg-muted" id="for">
  <div class="section-inner centered">
    <span class="script script-xl" style="color:var(--primary)">Who The Center Book Is For</span>
    <h2 class="headline">If students walk through your door, this was built for you.</h2>
    <div class="curve"></div>
    <div class="who-cards">
      <div class="who-card">
        <h3>High-Volume Centers</h3>
        <ul>
          <li>100+ enrolled students</li>
          <li>Multiple staff and shifts</li>
          <li>Families with more than one child</li>
          <li>Daily check-in and check-out</li>
          <li>Classroom session management</li>
        </ul>
      </div>
      <div class="who-card">
        <h3>Multi-Subject Programs</h3>
        <ul>
          <li>Math, reading, or both</li>
          <li>Level-based curriculum</li>
          <li>Placement testing on intake</li>
          <li>Progress tracking per subject</li>
          <li>Per-student scheduling</li>
        </ul>
      </div>
      <div class="who-card">
        <h3>Kumon Center Owners</h3>
        <ul>
          <li>Works alongside K-SIS and Kumon Connect</li>
          <li>Covers Kumon's attendance requirement</li>
          <li>Math, reading, or both subjects</li>
          <li>Progress meetings and level-ups</li>
          <li>Independent centers welcome too</li>
        </ul>
      </div>
    </div>
    <a href="#" class="btn btn-demo" data-cta="See If It's a Fit">See If It's a Fit</a>
  </div>
</section>
