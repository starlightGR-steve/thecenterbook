---
---
<section class="section bg-white">
  <div class="section-inner">
    <span class="eyebrow" style="color:var(--primary)">Student Management</span>
    <div class="feature-split">
      <div class="feat-text">
        <span class="script script-xl" style="color:var(--primary)">Every Student. Every Detail.</span>
        <h2 class="headline">One profile with the full picture.</h2>
        <p class="subhead">Complete student records with real multi-to-multi family relationships. Class planning, student tasks, attendance data, notes, goals, and communications, all on one page.</p>
        <div class="feat-points">
          <div class="feat-point">
            <div class="feat-point-icon solid solid-blue">
              <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            </div>
            <span><strong style="color:var(--text)">Full student profiles</strong><br>Enrollment, medical notes, flags, and audit-tracked permissions</span>
          </div>
          <div class="feat-point">
            <div class="feat-point-icon solid solid-blue">
              <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            </div>
            <span><strong style="color:var(--text)">Multi-to-multi contacts</strong><br>One parent, multiple children, separate billing and communication</span>
          </div>
          <div class="feat-point">
            <div class="feat-point-icon solid solid-blue">
              <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="8" height="4" x="8" y="2" rx="1" ry="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><path d="M12 11h4"/><path d="M12 16h4"/><path d="M8 11h.01"/><path d="M8 16h.01"/></svg>
            </div>
            <span><strong style="color:var(--text)">Class planning and student tasks</strong><br>Per-student plans and recurring to-dos that carry into check-in</span>
          </div>
          <div class="feat-point">
            <div class="feat-point-icon solid solid-blue">
              <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/></svg>
            </div>
            <span><strong style="color:var(--text)">Student attendance data</strong><br>Each student's own attendance history and patterns</span>
          </div>
        </div>
        <div><a href="#" class="btn btn-founding" data-cta="Book a Demo">Book a Demo</a></div>
      </div>
      <div class="feat-visual">
        <div class="blob" aria-hidden="true" style="background:radial-gradient(circle,rgba(53,92,170,.16),transparent 68%);width:120%;height:120%;top:-10%;left:-7%"></div>
        <div class="shot shot-fade" style="max-height:520px"><img loading="lazy" decoding="async" width="1966" height="1611" src="/images/student-profile.webp" alt="Student profile"></div>
      </div>
    </div>
  </div>
</section>
