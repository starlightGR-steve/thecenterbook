---
---
<section class="section bg-blue">
  <div class="section-inner">
    <span class="eyebrow" style="color:var(--primary)">Scheduling + Staff</span>
    <div class="feature-split reverse">
      <div class="feat-text">
        <span class="script script-xl" style="color:var(--primary)">Schedules, Shifts, and Time</span>
        <h2 class="headline">Student schedules, staff shifts, and time tracking. One place.</h2>
        <p class="subhead">Per-student, per-day schedules with weekly overrides. Staff shift management with conflict detection. Timeclock with CSV export. Booking calendar for progress meetings.</p>
        <div class="feat-points">
          <div class="feat-point">
            <div class="feat-point-icon solid solid-blue">
              <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/></svg>
            </div>
            <span><strong style="color:var(--text)">Student scheduling</strong><br>Per-day recurring schedules with per-week overrides</span>
          </div>
          <div class="feat-point">
            <div class="feat-point-icon solid solid-blue">
              <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            </div>
            <span><strong style="color:var(--text)">Staff shifts + coverage grid</strong><br>15-min precision blocks with conflict detection</span>
          </div>
          <div class="feat-point">
            <div class="feat-point-icon solid solid-blue">
              <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            </div>
            <span><strong style="color:var(--text)">Staff timeclock</strong><br>PIN/barcode entry, overtime split, CSV export for your payroll provider</span>
          </div>
          <div class="feat-point">
            <div class="feat-point-icon solid solid-blue">
              <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/></svg>
            </div>
            <span><strong style="color:var(--text)">Booking calendar</strong><br>Progress meetings with create, reschedule, and cancel</span>
          </div>
        </div>
        <div><a href="#" class="btn btn-founding" data-cta="See It Live">See It Live</a></div>
      </div>
      <div class="feat-visual">
        <div class="blob" aria-hidden="true" style="background:radial-gradient(circle,rgba(53,92,170,.16),transparent 68%);width:124%;height:120%;top:-10%;left:-12%"></div>
        <div class="shot"><img loading="lazy" decoding="async" width="2022" height="1089" src="/images/staff-coverage.webp" alt="Staff coverage grid"></div>
        <div class="float-el" style="bottom:30px;right:-15px">
          <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#007985" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/></svg> Capacity utilization
        </div>
      </div>
    </div>
  </div>
</section>
